{
  "_about": "Voice commands. Say the prefix, then a command: \"Computer, scroll down\". The prefix only counts at the start of what you say, so a sentence that merely contains the word is typed as usual. To change anything, copy this file to %APPDATA%\\VoiceOS\\commands.json and edit that copy; it replaces this one. 'phrases' are what Voiceitt writes when you say the command (English). 'group' is the heading the command is listed under in the command panel, which shows the first phrase. 'hebrew' is reserved for the Hebrew engine and not used yet. To point 'open mail' (or browser, terminal) at the right program without editing: open the program, pick it as the dictation window, and say \"Computer, this is my mail\".",
  "prefixes": [ "computer" ],
  "commands": [
    { "id": "open-edge",     "say": "opening Edge", "group": "Programs",        "phrases": [ "open edge", "open up", "switch to edge", "go to edge", "open browser", "open the browser" ], "action": { "type": "app", "process": "msedge", "launch": "msedge" } },
    { "id": "open-mail",     "say": "opening mail", "group": "Programs",        "phrases": [ "open mail", "open email", "open em client", "switch to mail", "go to mail" ], "action": { "type": "app", "process": "MailClient", "launch": "%ProgramFiles(x86)%\\eM Client\\MailClient.exe" } },
    { "id": "open-terminal", "say": "opening the terminal", "group": "Programs", "phrases": [ "open terminal", "switch to terminal", "go to terminal", "open claude", "switch to claude" ], "action": { "type": "app", "process": "WindowsTerminal", "launch": "wt" } },
    { "id": "open-files",    "say": "opening files", "group": "Programs",       "phrases": [ "open files", "open file explorer", "open explorer" ], "action": { "type": "keys", "keys": "win+e" } },

    { "id": "close-window",  "say": "closing", "group": "Windows",             "phrases": [ "close window", "close the window", "close this window" ], "action": { "type": "window", "value": "close" } },
    { "id": "minimize",      "say": "minimized", "group": "Windows",           "phrases": [ "minimize", "minimize window" ], "action": { "type": "window", "value": "minimize" } },
    { "id": "maximize",      "say": "maximized", "group": "Windows",           "phrases": [ "maximize", "maximize window", "full window" ], "action": { "type": "window", "value": "maximize" } },
    { "id": "restore",       "say": "restored", "group": "Windows",            "phrases": [ "restore window", "restore" ], "action": { "type": "window", "value": "restore" } },
    { "id": "show-desktop",  "say": "desktop", "group": "Windows",             "phrases": [ "show desktop", "go to desktop" ], "action": { "type": "keys", "keys": "win+d", "global": true } },
    { "id": "snap-left",     "say": "left", "group": "Windows",                "phrases": [ "snap left", "move left" ], "action": { "type": "keys", "keys": "win+left" } },
    { "id": "snap-right",    "say": "right", "group": "Windows",               "phrases": [ "snap right", "move right" ], "action": { "type": "keys", "keys": "win+right" } },
    { "id": "move-to-tv",    "say": "moving to the TV", "group": "Windows",    "phrases": [ "move to tv", "send to tv", "move to the tv", "other screen" ], "action": { "type": "keys", "keys": "win+shift+right" } },
    { "id": "move-back",     "say": "moving back", "group": "Windows",         "phrases": [ "move back", "move to main screen", "bring it back" ], "action": { "type": "keys", "keys": "win+shift+left" } },

    { "id": "scroll-down",   "say": "down", "group": "Moving around",                "phrases": [ "scroll down", "go down" ], "action": { "type": "scroll", "amount": -5 } },
    { "id": "scroll-up",     "say": "up", "group": "Moving around",                  "phrases": [ "scroll up", "go up" ], "action": { "type": "scroll", "amount": 5 } },
    { "id": "page-down",     "say": "page down", "group": "Moving around",           "phrases": [ "page down", "next page" ], "action": { "type": "keys", "keys": "pagedown" } },
    { "id": "page-up",       "say": "page up", "group": "Moving around",             "phrases": [ "page up", "previous page" ], "action": { "type": "keys", "keys": "pageup" } },
    { "id": "top",           "say": "top", "group": "Moving around",                 "phrases": [ "go to top", "top of page", "go to the top" ], "action": { "type": "keys", "keys": "ctrl+home" } },
    { "id": "bottom",        "say": "bottom", "group": "Moving around",              "phrases": [ "go to bottom", "bottom of page", "go to the bottom" ], "action": { "type": "keys", "keys": "ctrl+end" } },
    { "id": "back",          "say": "back", "group": "Moving around",                "phrases": [ "go back", "back" ], "action": { "type": "keys", "keys": "alt+left" } },
    { "id": "forward",       "say": "forward", "group": "Moving around",             "phrases": [ "go forward", "forward" ], "action": { "type": "keys", "keys": "alt+right" } },
    { "id": "new-tab",       "say": "new tab", "group": "Moving around",             "phrases": [ "new tab", "open new tab" ], "action": { "type": "keys", "keys": "ctrl+t" } },
    { "id": "close-tab",     "say": "tab closed", "group": "Moving around",          "phrases": [ "close tab", "close the tab" ], "action": { "type": "keys", "keys": "ctrl+w" } },
    { "id": "next-tab",      "say": "next tab", "group": "Moving around",            "phrases": [ "next tab" ], "action": { "type": "keys", "keys": "ctrl+tab" } },
    { "id": "previous-tab",  "say": "previous tab", "group": "Moving around",        "phrases": [ "previous tab", "last tab" ], "action": { "type": "keys", "keys": "ctrl+shift+tab" } },
    { "id": "refresh",       "say": "refreshing", "group": "Moving around",          "phrases": [ "refresh", "reload", "refresh page" ], "action": { "type": "keys", "keys": "f5" } },
    { "id": "zoom-in",       "say": "bigger", "group": "Moving around",              "phrases": [ "zoom in", "bigger" ], "action": { "type": "keys", "keys": "ctrl+plus" } },
    { "id": "zoom-out",      "say": "smaller", "group": "Moving around",             "phrases": [ "zoom out", "smaller" ], "action": { "type": "keys", "keys": "ctrl+minus" } },

    { "id": "enter",         "say": "enter", "group": "Editing",               "phrases": [ "press enter", "enter", "hit enter" ], "action": { "type": "keys", "keys": "enter" } },
    { "id": "escape",        "say": "escape", "group": "Editing",              "phrases": [ "press escape", "escape" ], "action": { "type": "keys", "keys": "escape" } },
    { "id": "tab",           "say": "tab", "group": "Editing",                 "phrases": [ "press tab", "tab key" ], "action": { "type": "keys", "keys": "tab" } },
    { "id": "undo",          "say": "undone", "group": "Editing",              "phrases": [ "take that back", "undo", "undo that", "under that", "oops" ], "action": { "type": "keys", "keys": "ctrl+z" } },
    { "id": "redo",          "say": "redone", "group": "Editing",              "phrases": [ "put it back", "redo", "redo that" ], "action": { "type": "keys", "keys": "ctrl+y" } },
    { "id": "copy",          "say": "copied", "group": "Editing",              "phrases": [ "grab that", "copy", "copy that", "copy text", "grab it" ], "action": { "type": "keys", "keys": "ctrl+c" } },
    { "id": "paste",         "say": "pasted", "group": "Editing",              "phrases": [ "drop it", "paste", "paste that", "paste text", "drop it here" ], "action": { "type": "keys", "keys": "ctrl+v" } },
    { "id": "cut",           "say": "cut", "group": "Editing",                 "phrases": [ "cut that", "cut" ], "action": { "type": "keys", "keys": "ctrl+x" } },
    { "id": "delete",        "say": "deleted", "group": "Editing",             "phrases": [ "delete", "delete that" ], "action": { "type": "keys", "keys": "delete" } },
    { "id": "select-all",    "say": "all selected", "group": "Editing",        "phrases": [ "select all" ], "action": { "type": "keys", "keys": "ctrl+a" } },
    { "id": "save",          "say": "saved", "group": "Editing",               "phrases": [ "save", "save file", "save that" ], "action": { "type": "keys", "keys": "ctrl+s" } },
    { "id": "find",          "say": "find", "group": "Moving around",                "phrases": [ "find", "search page" ], "action": { "type": "keys", "keys": "ctrl+f" } },

    { "id": "stop-typing",   "say": "typing off, still listening", "group": "Typing", "phrases": [ "stop dictation", "stop typing" ], "action": { "type": "typing", "value": "off" } },
    { "id": "start-typing",  "say": "typing on", "group": "Typing",           "phrases": [ "start dictation", "start typing" ], "action": { "type": "typing", "value": "on" } },

    { "id": "play-pause",    "say": "OK", "group": "Video and sound",                  "phrases": [ "start video", "play", "pause", "powers", "play pause", "pause video", "stop video", "resume video" ], "action": { "type": "keys", "keys": "playpause", "global": true } },
    { "id": "volume-up",     "say": "louder", "group": "Video and sound",              "phrases": [ "louder", "volume up" ], "action": { "type": "keys", "keys": "volumeup volumeup volumeup volumeup volumeup", "global": true } },
    { "id": "volume-down",   "say": "quieter", "group": "Video and sound",             "phrases": [ "quieter", "volume down", "softer" ], "action": { "type": "keys", "keys": "volumedown volumedown volumedown volumedown volumedown", "global": true } },
    { "id": "mute",          "say": "muted", "group": "Video and sound",               "phrases": [ "mute", "unmute", "mute sound" ], "action": { "type": "keys", "keys": "volumemute", "global": true } },
    { "id": "full-screen",   "say": "full screen", "group": "Video and sound",         "phrases": [ "full screen", "fullscreen", "exit full screen" ], "action": { "type": "keys", "keys": "f11" } },
    { "id": "skip-forward",  "say": "skipping", "group": "Video and sound",            "phrases": [ "skip forward", "skip ahead" ], "action": { "type": "keys", "keys": "right" } },
    { "id": "skip-back",     "say": "rewinding", "group": "Video and sound",           "phrases": [ "skip back", "rewind" ], "action": { "type": "keys", "keys": "left" } },

    { "id": "this-is-browser",  "say": "OK, this is your browser", "group": "Programs",  "phrases": [ "this is my browser", "this is the browser", "this is edge" ], "action": { "type": "assign", "value": "open-edge" } },
    { "id": "this-is-mail",     "say": "OK, this is your mail", "group": "Programs",     "phrases": [ "this is my mail", "this is mail", "this is the mail" ], "action": { "type": "assign", "value": "open-mail" } },
    { "id": "this-is-terminal", "say": "OK, this is your terminal", "group": "Programs", "phrases": [ "this is my terminal", "this is the terminal", "this is claude" ], "action": { "type": "assign", "value": "open-terminal" } },
    { "id": "show-commands",   "say": "here they are", "group": "This panel and settings",  "phrases": [ "show commands", "what can i say", "help" ], "action": { "type": "panel", "value": "show" } },
    { "id": "hide-commands",   "say": "hidden", "group": "This panel and settings",         "phrases": [ "hide commands", "close commands", "hide help" ], "action": { "type": "panel", "value": "hide" } },
    { "id": "edit-commands",    "say": "opening the command list", "group": "This panel and settings",  "phrases": [ "edit commands", "open command list", "change commands" ], "action": { "type": "edit-commands" } },

    { "id": "feedback-sound",  "say": "sounds", "group": "This panel and settings",        "phrases": [ "use sounds", "beep mode" ], "action": { "type": "feedback", "value": "sound" } },
    { "id": "feedback-speech", "say": "I'll talk", "group": "This panel and settings",     "phrases": [ "talk to me", "use voice", "speak mode" ], "action": { "type": "feedback", "value": "speech" } },
    { "id": "feedback-off",    "say": "", "group": "This panel and settings",              "phrases": [ "be quiet", "silent mode", "no sounds" ], "action": { "type": "feedback", "value": "off" } },

    { "id": "cancel",        "say": "cancelled", "group": "This panel and settings",           "phrases": [ "cancel", "never mind", "nothing" ], "action": { "type": "none" } }
  ]
}
